import pandas as pd
import statsmodels.api as sm
import matplotlib.pyplot as plt
from tabulate import tabulate
from sklearn.metrics import mean_absolute_error

df = pd.read_csv('../data/nhtsa_clean.csv', parse_dates=['FAILDATE'])

meses = df['FAILDATE'].dt.to_period('M')
conteo = meses.value_counts().sort_index()
conteo = conteo[conteo.index >= '2020-01']
x_secuencia = list(range(len(conteo)))
df_reporte = pd.DataFrame({'x': x_secuencia, 'y': conteo.values})

df_train = df_reporte.head(54)
df_test = df_reporte.tail(6)

x = sm.add_constant(df_train['x'])
modelo = sm.OLS(df_train['y'], x).fit()

#predecir modelo
prediccion = modelo.predict(sm.add_constant(df_test['x']))
df_test['prediccion'] = prediccion

tabla = conteo.groupby([conteo.index.year, conteo.index.month]).sum().unstack()
#porcentaje de cambio de agosto a diciembre por año
serie = (tabla[12] - tabla[8]) / tabla[8]
# print(serie)

#mae recta
mae = mean_absolute_error(df_test['y'], df_test['prediccion'])

#mae modelo test
ultimo = df_train['y'].iloc[-1]
df_test['ultimo'] = ultimo
mae_ultimo= mean_absolute_error(df_test['y'], df_test['ultimo'])

#modelo final
df_final = df_reporte.head(56)
x_final = sm.add_constant(df_final['x'])
modelo_final = sm.OLS(df_final['y'], x_final).fit()
x_futuro = pd.DataFrame({'x': range(56, 72)})
pred_futuro = modelo_final.get_prediction(sm.add_constant(x_futuro))
tabla_futuro = pred_futuro.summary_frame(alpha=0.05)
print(tabla_futuro)
print(modelo.params)
print(modelo_final.params)
